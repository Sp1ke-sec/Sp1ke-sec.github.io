	width=&#34;2161&#34;
	height=&#34;459&#34;
	srcset=&#34;https://Sp1ke-sec.github.io/p/htb-sherlocks-dfir%E7%B3%BB%E5%88%97/assets/image-20261109172652784_hu7191443732286771526.png 480w, https://Sp1ke-sec.github.io/p/htb-sherlocks-dfir%E7%B3%BB%E5%88%97/assets/image-20261109172652784_hu6719496475719934932.png 1024w&#34;
