&lt;/h1&gt;&lt;p&gt;&lt;img src=&#34;https://Sp1ke-sec.github.io/p/14.-cap/assets/image-20261108105321725.png&#34;
	width=&#34;403&#34;
	height=&#34;192&#34;
	srcset=&#34;https://Sp1ke-sec.github.io/p/14.-cap/assets/image-20261108105321725_hu14285743941944886084.png 480w, https://Sp1ke-sec.github.io/p/14.-cap/assets/image-20261108105321725_hu6914197008680624505.png 1024w&#34;
